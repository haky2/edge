-- 투자 행동 로그. Phase 4 학습의 입력값 — reason(왜 샀나/관심뒀나)을 Phase 1부터 포함한다.
-- action: 'interest' | 'buy' | 'sell' | 'view' 등(문자열로 느슨하게, 나중에 enum 매핑).
-- reason: 매수/매도/관심 시 한 줄 사유 태그. 마찰 없이 남기게 하는 게 핵심이라 NULL 허용.
-- price: 기록 시점 현재가(원). v3 추가(2.sqm). 기존 행 NULL.
CREATE TABLE action_log (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    code        TEXT NOT NULL,
    name        TEXT,                  -- 종목명. 구버전 DB 행은 NULL → nameMap 폴백.
    action      TEXT NOT NULL,
    reason      TEXT,
    price       INTEGER,               -- 기록 시점 현재가 (원). 없으면 NULL.
    created_at  INTEGER NOT NULL       -- epoch millis
);

insert:
INSERT INTO action_log(code, name, action, reason, price, created_at)
VALUES (?, ?, ?, ?, ?, ?);

selectByCode:
SELECT id, code, name, action, reason, price, created_at
FROM action_log
WHERE code = ?
ORDER BY created_at DESC;

selectRecent:
SELECT id, code, name, action, reason, price, created_at
FROM action_log
ORDER BY created_at DESC
LIMIT ?;

selectAll:
SELECT id, code, name, action, reason, price, created_at
FROM action_log
ORDER BY created_at DESC;

deleteById:
DELETE FROM action_log WHERE id = ?;
