-- 관심종목. 코드가 PK, 이름은 /quote 응답에 없어 여기 보관(화면에서 시세와 합침).
-- sort_order: CLAUDE.md 우선순위 보존(작을수록 위).
-- 1.5a: 내 포지션 필드(평단가·수량·목표가·손절가) 추가. 모두 nullable — 입력 전 상태.
--   기존 DB는 migrations/1.sqm 로 ALTER(컬럼 추가)된다.
CREATE TABLE watchlist (
    code         TEXT NOT NULL PRIMARY KEY,
    name         TEXT NOT NULL,
    sort_order   INTEGER NOT NULL,
    added_at     INTEGER NOT NULL,   -- epoch millis
    avg_price    REAL,               -- 평단가(원) — G1 이후 항상 NULL(holding이 정본)
    qty          INTEGER,            -- 보유 수량  — G1 이후 항상 NULL
    target_price REAL,               -- 목표가     — G1 이후 항상 NULL
    stop_price   REAL,               -- 손절가     — G1 이후 항상 NULL
    thesis       TEXT                -- 투자 논지(사용자가 직접 기록한 보유/관심 이유, 최대 200자)
);

selectAll:
SELECT code, name, avg_price, qty, target_price, stop_price, thesis
FROM watchlist ORDER BY sort_order ASC;

count:
SELECT count(*) FROM watchlist;

-- ⚠️ OR REPLACE는 행 전체를 교체한다 — 여기 없는 컬럼(thesis)은 NULL로 초기화되므로
-- 기존 코드에 직접 쓰면 안 된다. 리포지토리 add()가 존재 여부를 확인하고 분기한다.
insert:
INSERT OR REPLACE INTO watchlist(code, name, sort_order, added_at)
VALUES (?, ?, ?, ?);

existsByCode:
SELECT count(*) FROM watchlist WHERE code = ?;

updateName:
UPDATE watchlist SET name = ? WHERE code = ?;

-- 포지션 쓰기는 G1부터 holding 테이블이 정본(HoldingRepository.savePosition*).
-- watchlist 포지션 컬럼은 스키마 호환용으로만 남아 있고 항상 NULL이다.

updateThesis:
UPDATE watchlist SET thesis = ? WHERE code = ?;

deleteByCode:
DELETE FROM watchlist WHERE code = ?;
