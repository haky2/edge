# 한투(KIS) Open API 키 — 실제 값은 backend/.env 에 넣고 절대 커밋하지 않는다.
# (backend/.env 는 루트 .gitignore 의 .env* 규칙으로 무시됨)
KIS_APP_KEY=여기에_appkey_붙여넣기
KIS_APP_SECRET=여기에_appsecret_붙여넣기

# 실전 계좌: https://openapi.koreainvestment.com:9443  (기본값)
# 모의투자:  https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

PORT=8080

# 네이버 검색 OpenAPI — 뉴스 헤드라인 수집용 (2b)
# 발급: https://developers.naver.com/apps → 검색 API
NAVER_CLIENT_ID=여기에_client_id_붙여넣기
NAVER_CLIENT_SECRET=여기에_client_secret_붙여넣기
