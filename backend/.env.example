# 한투(KIS) Open API 키 — 실제 값은 backend/.env 에 넣고 절대 커밋하지 않는다.
# (backend/.env 는 루트 .gitignore 의 .env* 규칙으로 무시됨)
KIS_APP_KEY=여기에_appkey_붙여넣기
KIS_APP_SECRET=여기에_appsecret_붙여넣기

# 실전 계좌: https://openapi.koreainvestment.com:9443  (기본값)
# 모의투자:  https://openapivts.koreainvestment.com:29443
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

PORT=8080

# 네이버 검색 OpenAPI — 뉴스 헤드라인 수집용 (2b)
# 발급: https://developers.naver.com/apps → 검색 API
NAVER_CLIENT_ID=여기에_client_id_붙여넣기
NAVER_CLIENT_SECRET=여기에_client_secret_붙여넣기

# Claude API — 종목 종합 코멘트 생성용 (2c)
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=여기에_anthropic_api_key_붙여넣기
# (선택) 분석 모델 덮어쓰기. 기본 claude-sonnet-4-6
# CLAUDE_MODEL=claude-sonnet-4-6

# DART Open API — 공시 조회용 (Phase 3)
# 발급: https://opendart.fss.or.kr → 인증키 신청
DART_API_KEY=여기에_dart_api_key_붙여넣기

# 배포 보안 게이트(1.0c-a) — 앱↔백엔드 공유 토큰.
# 비워두면 인증을 건너뛴다(로컬 개발). 배포 시에만 긴 랜덤 값을 넣고, iOS 앱에도 같은 값을 박는다.
# 생성 예: openssl rand -hex 24
EDGE_API_TOKEN=

# Slack Edge Bot
SLACK_BOT_TOKEN=
# Slack ops-오류 채널 ID
SLACK_OPS_CHANNEL=
